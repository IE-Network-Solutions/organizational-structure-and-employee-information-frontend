# Copy to `.env.local` only if you need overrides. Restart `npm run dev` after changes.
#
# Local dev: disable API encryption when backend does not encrypt responses
# NEXT_PUBLIC_ENCRYPTION_DISABLED=true
#
# Set to true when embedding this app inside the SelamNew Core host, which
# provides its own top bar — hides this app's own header (top nav) and sidebar logo.
# NEXT_PUBLIC_IS_CORE=true
#
# Remote API (default — use when local backend is NOT running):
ORG_AND_EMP_URL=https://redesign-api.ienetworks.co/org-emp/api/v1
#
# Local backend (uncomment instead when org-emp is running on port 8008):
# ORG_AND_EMP_URL=http://localhost:8008/api/v1
#
# Copilot API base URL (chat: POST {base}/copilot)
# NEXT_PUBLIC_COPILOT_BASE_URL=https://selamnew-copilot-dev-dbdcc9ahe7eqgbez.eastus-01.azurewebsites.net
